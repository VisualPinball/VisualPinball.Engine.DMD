<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(PlatformTarget)' == 'arm64'">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(PlatformTarget)' != 'arm64'">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibDmd.Core" Version="[$(LibDmdVersion)]" />
    <PackageDownload Include="LibDmd.Core.Unity" Version="[$(LibDmdVersion)]" />
  </ItemGroup>

  <Target Name="PluginsDeploy" AfterTargets="AfterBuild">
    <PropertyGroup>
      <UnityPluginsRoot>..\VisualPinball.Engine.DMD.Unity\Plugins</UnityPluginsRoot>
      <UnityNativeDir>$(UnityPluginsRoot)\$(RuntimeIdentifier)</UnityNativeDir>
      <LibDmdNativeDir>$(NuGetPackageRoot)/libdmd.core.native.$(RuntimeIdentifier)/$(LibDmdVersion)/runtimes/$(RuntimeIdentifier)/native</LibDmdNativeDir>
      <LibDmdUnityDir>$(NuGetPackageRoot)/libdmd.core.unity/$(LibDmdVersion)/unity/managed</LibDmdUnityDir>
      <!-- All managed assemblies are RID-agnostic, so they live in ONE shared "Any Platform" folder
           instead of being duplicated per-RID. Duplicated managed copies were a trap: a single-RID
           rebuild desynced them and silently broke Unity's Editor compilation. Natives stay per-RID. -->
      <UnityManagedDir>$(UnityPluginsRoot)\Managed</UnityManagedDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- The Unity payload supplies both backends and replaces the stock System.IO.Ports with
           the libserialport-backed Mono shim. The engine supplies NLog. -->
      <ManagedPlugins Include="@(ReferenceCopyLocalPaths)"
                      Condition="'%(ReferenceCopyLocalPaths.AssetType)' == 'runtime'
                                 And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                 And '%(ReferenceCopyLocalPaths.Filename)' != 'NLog'
                                 And '%(ReferenceCopyLocalPaths.Filename)' != 'System.IO.Ports'" />
      <ManagedPlugins Include="$(TargetPath);$(LibDmdUnityDir)/*.dll" />

      <!-- Native (per-RID). -->
      <NativePlugins Include="$(LibDmdNativeDir)/*" />

      <!-- Cleanup: managed assemblies (+ metas) left in the per-RID folders by the old layout. The
           '*-*' glob matches only the RID folders (win-x64, linux-x64, osx-x64, osx-arm64), never
           the hyphen-less 'Managed' folder, so the shared copies are preserved. -->
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\LibDmd.Core*.dll*" />
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\VisualPinball.Engine.DMD.dll*" />
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\System.Reactive.dll*" />
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\System.IO.Ports.dll*" />
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\System.Runtime.CompilerServices.Unsafe.dll*" />
      <StaleManagedInRid Include="$(UnityPluginsRoot)\*-*\System.Threading.Tasks.Extensions.dll*" />

      <StaleNLogPlugins Include="$(UnityPluginsRoot)\**\NLog.dll" />
      <StaleNLogPlugins Include="$(UnityPluginsRoot)\**\NLog.dll.meta" />
    </ItemGroup>

    <Message Text="PluginsDeploy ($(RuntimeIdentifier)): managed -> Managed/, native -> $(RuntimeIdentifier)/" Importance="High" />
    <MakeDir Directories="$(UnityManagedDir);$(UnityNativeDir)" />
    <Copy SourceFiles="@(ManagedPlugins)" DestinationFolder="$(UnityManagedDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativePlugins)" DestinationFolder="$(UnityNativeDir)" SkipUnchangedFiles="true" />
    <!-- The Linux package contains versioned files. The Unity shim and ZeDMD need these aliases. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <_LinuxSerialPort Include="$(LibDmdNativeDir)/libserialport.so.*" />
    </ItemGroup>
    <Copy Condition="'$(RuntimeIdentifier)' == 'linux-x64' And '@(_LinuxSerialPort)' != ''"
          SourceFiles="@(_LinuxSerialPort)"
          DestinationFiles="$(UnityNativeDir)\libserialport.so" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <_LinuxSockpp Include="$(LibDmdNativeDir)/libsockpp.so.1.*" />
    </ItemGroup>
    <Copy Condition="'$(RuntimeIdentifier)' == 'linux-x64' And '@(_LinuxSerialPort)' != ''"
          SourceFiles="@(_LinuxSerialPort)"
          DestinationFiles="$(UnityNativeDir)\libserialport.so.0" SkipUnchangedFiles="true" />
    <Copy Condition="'$(RuntimeIdentifier)' == 'linux-x64' And '@(_LinuxSockpp)' != ''"
          SourceFiles="@(_LinuxSockpp)"
          DestinationFiles="$(UnityNativeDir)\libsockpp.so.1" SkipUnchangedFiles="true" />
    <Delete Files="@(StaleManagedInRid)" />
    <Delete Files="@(StaleNLogPlugins)" />
  </Target>
</Project>
