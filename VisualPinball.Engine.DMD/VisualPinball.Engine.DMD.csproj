<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <LibDmdExtensionsRoot Condition="'$(LibDmdExtensionsRoot)' == ''">C:\Development\dmd-extensions</LibDmdExtensionsRoot>
    <LibDmdCoreProject>$(LibDmdExtensionsRoot)\LibDmd.Core\LibDmd.Core.csproj</LibDmdCoreProject>
    <LibDmdCoreWindowsProject>$(LibDmdExtensionsRoot)\LibDmd.Core.Windows\LibDmd.Core.Windows.csproj</LibDmdCoreWindowsProject>
    <LibDmdCoreSdlProject>$(LibDmdExtensionsRoot)\LibDmd.Core.Sdl\LibDmd.Core.Sdl.csproj</LibDmdCoreSdlProject>
    <LibDmdNativeRoot>$(LibDmdExtensionsRoot)\native\nuget\runtimes</LibDmdNativeRoot>
    <LibDmdCostura64Root>$(LibDmdExtensionsRoot)\LibDmd\Costura64</LibDmdCostura64Root>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(PlatformTarget)' == 'arm64'">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(PlatformTarget)' != 'arm64'">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibDmdCoreProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ProjectReference Include="$(LibDmdCoreWindowsProject)" />
  </ItemGroup>
  <!-- Cross-platform host-pumped SDL/GL-ES window for macOS/Linux (the SDL2 + ANGLE native
       runtimes must be supplied alongside; not bundled here). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64' And '$(RuntimeIdentifier)' != ''">
    <ProjectReference Include="$(LibDmdCoreSdlProject)" />
  </ItemGroup>

  <Target Name="PluginsDeploy" AfterTargets="AfterBuild">
    <PropertyGroup>
      <UnityPluginsDir>..\VisualPinball.Engine.DMD.Unity\Plugins\$(RuntimeIdentifier)</UnityPluginsDir>
    </PropertyGroup>

    <ItemGroup>
      <Plugins Include="$(OutDir)*.dll" Exclude="$(OutDir)NLog.dll" />
      <Plugins Include="$(LibDmdNativeRoot)\$(RuntimeIdentifier)\native\*" />
      <Plugins Include="$(LibDmdCostura64Root)\ftd2xx.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <Plugins Include="$(LibDmdCostura64Root)\libserialport64-0.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <Plugins Include="$(LibDmdCostura64Root)\libSkiaSharp.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <Plugins Include="$(LibDmdCostura64Root)\sockpp64.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <Plugins Include="$(LibDmdCostura64Root)\sqlite3.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <StaleNLogPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\**\NLog.dll" />
      <StaleNLogPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\**\NLog.dll.meta" />
      <StaleWindowsPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\linux-x64\LibDmd.Core.Windows.dll" />
      <StaleWindowsPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\osx-x64\LibDmd.Core.Windows.dll" />
      <StaleWindowsPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\osx-arm64\LibDmd.Core.Windows.dll" />
      <StaleWindowsPlugins Include="..\VisualPinball.Engine.DMD.Unity\Plugins\win-x64\LibDmd.Core.Sdl.dll" />
    </ItemGroup>

    <Message Text="PluginsDeploy ($(RuntimeIdentifier)): @(Plugins)" Importance="High" />
    <MakeDir Directories="$(UnityPluginsDir)" />
    <Copy SourceFiles="@(Plugins)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" />
    <Delete Files="@(StaleNLogPlugins)" />
    <Delete Files="@(StaleWindowsPlugins)" />
  </Target>
</Project>
